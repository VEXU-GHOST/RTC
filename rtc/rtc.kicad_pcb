	(gr_text "VEXU GHOST RTC Board V3\n\nReal-time clock (RTC) board with a supercapacitor backup\npower supply for clock correction on a Jetson Orin Nano.\n\nThe board is positioned on top of the lower-end GPIO pins,\nand board is interfaced to the Orin through I2C, providing\ntwo I2C connectors for Adafruit STEMMA QT products.\n\nBoard layers: 2\nBoard area: 1026 mm^2\nBoard approved for fabrication on: 11/10/2026\n\nDesigned by Hailin Chen\nReviewed by Allen Ai\n\n"
		(at 147.8 126.8 0)
		(layer "Cmts.User")
		(uuid "d58c4a66-ae12-42fe-86e0-0ce79f3d2093")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
